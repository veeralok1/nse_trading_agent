# ══════════════════════════════════════════════════════════════
#  NSE Trading Agent — Example Environment File
#  Copy this file to .env and fill in your actual values.
#  Command:  copy .env.example .env   (Windows)
#            cp .env.example .env     (Linux/macOS)
# ══════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────
# ANTHROPIC (Claude AI)
# Get your key at: https://console.anthropic.com
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# OPENAI  (GPT-4 / GPT-4o)  — optional
# Get your key at: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────
# TELEGRAM BOT  (alerts)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=987654321

# ─────────────────────────────────────────────
# EMAIL ALERTS
# ─────────────────────────────────────────────
ALERT_EMAIL_SENDER=youremail@gmail.com
ALERT_EMAIL_PASSWORD=your_app_password_here
ALERT_EMAIL_RECEIVER=alerts@yourdomain.com
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587

# ─────────────────────────────────────────────
# BROKER — Zerodha Kite Connect
# ─────────────────────────────────────────────
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_ACCESS_TOKEN=your_zerodha_access_token

# ─────────────────────────────────────────────
# BROKER — Upstox
# ─────────────────────────────────────────────
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret

# ─────────────────────────────────────────────
# APP SETTINGS
# ─────────────────────────────────────────────
TRADING_CAPITAL=100000
RISK_PER_TRADE=0.01
ENABLE_LLM_CHAT=false
LLM_PROVIDER=anthropic
